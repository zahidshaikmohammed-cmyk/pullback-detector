APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Secrets: leave blank locally unless intentionally running a real Dhan session.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_WS_URL=wss://api-feed.dhan.co

DATA_ROOT=data/runtime
MAX_RECONNECTS=5
MAX_FUTURE_SECONDS=5
MAX_TICK_AGE_SECONDS=300
DEDUPE_CAPACITY=100000
MIN_LIVE_INSTRUMENTS=3
LIVE_DURATION_SECONDS=600

# Pullback/alert configuration is retained for later stages but is unused by
# the current data-only connectivity service.
PULLBACK_LOOKBACK_BARS=20
PULLBACK_MIN_RETRACE=0.25
PULLBACK_MAX_RETRACE=0.618
PULLBACK_MIN_TREND_STRENGTH=0.0
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300
